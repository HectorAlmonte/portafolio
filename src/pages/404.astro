---
import Layout from '../layouts/Layout.astro';
import Scene from '../components/Scene.astro';
import Icon from '../components/Icon.astro';
---

<Layout title="404" description="Página no encontrada / Page not found" lang="es" footerCta={false}>
  <Scene lang="es" title={['404']} seed={61}>
    <div class="lost on-dark">
      <p class="lede">
        Este sendero no lleva a ninguna parte.
        <span lang="en">This trail doesn't lead anywhere.</span>
      </p>
      <div class="actions">
        <a href="/es/" class="pill pill--light"><Icon name="back" size={18} /> Volver al inicio</a>
        <a href="/en/" class="pill pill--ghost" lang="en">Back home</a>
      </div>
    </div>
  </Scene>
</Layout>

<style>
  .lost {
    margin-top: auto;
    padding: 0 clamp(16px, 3vw, 40px) clamp(18px, 3vw, 36px);
    color: var(--ink-on-dark);
  }
  .lede { margin: 0 0 20px; }
  .lede span { display: block; color: var(--ink-on-dark-soft); font-size: 0.9em; }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; }
</style>
