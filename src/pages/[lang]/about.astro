---
import Layout from '../../layouts/Layout.astro';
import Scene from '../../components/Scene.astro';
import Ridge from '../../components/Ridge.astro';
import Icon from '../../components/Icon.astro';
import { languages, type Lang } from '../../i18n/translations';
import { useTranslations, cvPath } from '../../i18n/utils';
import Timeline from '../../components/Timeline.astro';

export function getStaticPaths() {
  return languages.map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);
const es = lang === 'es';

const facts = es
  ? [
      ['Nombre', 'Hector Gabriel Almonte Salazar'],
      ['Rol', 'Ingeniero de Sistemas · Full Stack'],
      ['Base', 'Ilo, Perú · GMT−5'],
      ['Idiomas', 'Español (nativo), inglés (B2/C1)'],
      ['Fuera del código', 'Pescar al amanecer'],
      ['Disponibilidad', 'Abierto a roles remotos'],
    ]
  : [
      ['Name', 'Hector Gabriel Almonte Salazar'],
      ['Role', 'Systems Engineer · Full Stack'],
      ['Based in', 'Ilo, Peru · GMT−5'],
      ['Languages', 'Spanish (native), English (B2/C1)'],
      ['Off the clock', 'Fishing at sunrise'],
      ['Availability', 'Open to remote roles'],
    ];

const principles = es
  ? [
      { h: 'Entender el dominio primero', p: 'Hablar con quien va a usarlo y ver el problema en persona. Escribir el caso en una frase antes que una línea de código.' },
      { h: 'Lo más simple que funcione', p: 'Stack aburrido antes que stack brillante: Postgres, Next.js, TypeScript. La novedad la añado donde paga.' },
      { h: 'Cuidar lo invisible', p: 'Logs, modo offline, errores legibles. El software que dura es el que se puede operar a las 3 de la mañana.' },
      { h: 'Terminar las cosas', p: 'Un proyecto al 80% es un proyecto al 0%. Prefiero un MVP en producción que un borrador eterno.' },
    ]
  : [
      { h: 'Understand the domain first', p: 'Talk to the people who will use it and see the problem in person. Write the use case in one sentence before one line of code.' },
      { h: 'The simplest thing that works', p: 'Boring stack over shiny stack: Postgres, Next.js, TypeScript. I add novelty where it pays off.' },
      { h: 'Care for the invisible', p: 'Logs, offline mode, readable errors. Software that lasts is software you can operate at 3am.' },
      { h: 'Finish things', p: 'A project at 80% is a project at 0%. I prefer an MVP in production over an endless draft.' },
    ];

const toolbox = [
  { h: es ? 'Uso a diario' : 'Daily drivers', items: ['TypeScript', 'JavaScript', 'React', 'Next.js', 'Node.js', 'PostgreSQL'] },
  { h: es ? 'Con experiencia' : 'Experienced with', items: ['.NET C#', 'ASP.NET', 'SQL Server', 'Docker', 'Mapbox', 'PWA'] },
  { h: es ? 'Aprendiendo' : 'Learning', items: ['Design Systems', es ? 'Accesibilidad WCAG' : 'WCAG accessibility', 'Three.js / WebGL', 'Motion design'] },
];

const quote = es
  ? 'La complejidad no se elimina, se desplaza. Que se desplace lejos del usuario.'
  : "Complexity isn't eliminated, it's displaced. Let it be displaced away from the user.";
---

<Layout title={t.nav.about} description={t.meta.about} lang={lang}>
  <Scene lang={lang} variant="band" title={es ? ['Sobre mí'] : ['About me']} seed={13} />

  <section class="band band--cream story">
    <div class="wrap story-grid">
      <div class="prose">
        <p class="lede first">
          {es
            ? 'Soy Héctor. Vivo en Ilo, un puerto al sur de Perú, y escribo software desde 2021 buscando el equilibrio entre código limpio y problemas reales.'
            : "I'm Héctor. I live in Ilo, a port in southern Peru, and I've been writing software since 2021, chasing the balance between clean code and real problems."}
        </p>
        <h2 class="sub">{es ? 'De dónde vengo' : 'Where I come from'}</h2>
        <p>
          {es
            ? 'Empecé escribiendo aplicaciones de escritorio en C# para mi propia universidad. Al graduarme, Agrosoft me dejó hacer algo más ambicioso: visualizar flotas enteras de maquinaria agrícola sobre un mapa en tiempo real, con telemetría, alertas y reportes para los dueños de las haciendas.'
            : 'I started writing desktop applications in C# for my own university. When I graduated, Agrosoft let me do something more ambitious: show entire fleets of farm machinery on a real-time map, with telemetry, alerts and reports for the farm owners.'}
        </p>
        <p>
          {es
            ? 'Pasé tres años ahí. Aprendí a trabajar con bases de datos enormes sin perder la calma, a diseñar reportes que un agricultor entiende y a tratar el código como una herramienta, no como un fin.'
            : 'I spent three years there. I learned to work with huge databases without losing my cool, to design reports a farmer understands, and to treat code as a tool, not an end in itself.'}
        </p>
        <h2 class="sub">{es ? 'Qué hago hoy' : 'What I do today'}</h2>
        <p>
          {es
            ? 'Desde diciembre de 2025 superviso los sistemas y operaciones de Global Plus, una empresa de almacenaje de materiales peligrosos en Ilo. Mi día se divide entre las operaciones y el software que las hace posibles: un sistema de seguridad industrial con modo offline y una PWA para consultar los 2,661 materiales de la guía GRE 2024.'
            : 'Since December 2025 I supervise systems and operations at Global Plus, a hazardous materials storage company in Ilo. My day splits between operations and the software that makes them possible: an industrial safety system with offline mode and a PWA to look up the 2,661 materials in the ERG 2024 guide.'}
        </p>
        <a href={cvPath(lang)} download class="pill pill--dark cv">
          <Icon name="download" size={18} /> {t.common.cv}
        </a>
      </div>

      <aside class="facts">
        <dl>
          {facts.map(([k, v]) => (
            <div><dt>{k}</dt><dd>{v}</dd></div>
          ))}
        </dl>
      </aside>
    </div>
  </section>

  <Ridge fill="var(--sand)" shape="hills" seed={17} />
  <section class="band band--sand how">
    <div class="wrap">
      <h2 class="h2">{es ? 'Cómo trabajo' : 'How I work'}</h2>
      <ul class="principles">
        {principles.map((p, i) => (
          <li data-reveal style={`--i:${i}`}>
            <h3>{p.h}</h3>
            <p>{p.p}</p>
          </li>
        ))}
      </ul>

      <div class="toolbox">
        {toolbox.map(group => (
          <div>
            <h3>{group.h}</h3>
            <ul>{group.items.map(item => <li class="chip">{item}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Ridge fill="var(--rust)" shape="peaks" flip />
  <section class="band band--rust on-dark path">
    <div class="wrap">
      <blockquote class="quote">
        <p>{quote}</p>
        <footer>{es ? 'Algo que me repito' : 'Something I tell myself'}</footer>
      </blockquote>

      <h2 class="h2">{es ? 'Trayectoria' : 'Experience'}</h2>
      <Timeline lang={lang} detailed />
    </div>
  </section>
</Layout>

<style>
  .story { padding: clamp(64px, 9vw, 120px) 0 clamp(96px, 12vw, 160px); }
  .story-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(260px, 1fr);
    gap: clamp(40px, 7vw, 112px);
    align-items: start;
  }
  .first { max-width: none; margin-bottom: 1.6em; color: var(--ink); }
  .sub {
    margin: 2.2em 0 0.6em;
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: 1.35rem;
    line-height: 1.1;
  }
  .prose p:not(.first) { color: var(--ink-soft); }
  .cv { margin-top: 1.4em; }

  .facts { position: sticky; top: 32px; }
  .facts dl { margin: 0; border-top: 2px solid var(--night); }
  .facts dl div { padding: 14px 0; border-bottom: 1px solid var(--rule); }
  .facts dt { font-size: 0.82rem; font-weight: 700; letter-spacing: 0.03em; color: var(--ink-soft); }
  .facts dd { margin: 2px 0 0; font-weight: 500; }

  .how { padding: clamp(48px, 6vw, 80px) 0 clamp(110px, 13vw, 180px); }
  .principles {
    list-style: none;
    margin: clamp(32px, 4vw, 56px) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 44px 56px;
  }
  .principles li { padding-top: 18px; border-top: 2px solid var(--night); }
  .principles h3, .toolbox h3 {
    margin: 0 0 10px;
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: 1.3rem;
    line-height: 1.05;
  }
  .principles p { margin: 0; color: var(--ink-soft); max-width: 46ch; }

  .toolbox {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
    margin-top: clamp(56px, 7vw, 96px);
  }
  .toolbox ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .toolbox .chip { border-color: rgba(44, 15, 30, 0.3); }

  .path { padding: clamp(48px, 6vw, 80px) 0 clamp(110px, 13vw, 180px); }
  .quote { margin: 0 0 clamp(64px, 8vw, 112px); max-width: 26ch; }
  .quote p {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.8rem, 3.6vw, 3rem);
    line-height: 1.08;
    text-wrap: balance;
  }
  .quote footer { margin-top: 16px; color: var(--ink-on-dark-soft); font-weight: 600; }
  .path .h2 { margin-bottom: clamp(24px, 3vw, 40px); }


  @media (max-width: 900px) {
    .story-grid { grid-template-columns: 1fr; }
    .facts { position: static; }
    .toolbox { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .principles { grid-template-columns: 1fr; gap: 28px; }
  }
</style>
