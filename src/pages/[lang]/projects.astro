---
import Layout from '../../layouts/Layout.astro';
import Scene from '../../components/Scene.astro';
import Icon from '../../components/Icon.astro';
import ProjectRows from '../../components/ProjectRows.astro';
import { languages, type Lang } from '../../i18n/translations';
import { useTranslations, GITHUB } from '../../i18n/utils';
import { projects } from '../../data/projects';

export function getStaticPaths() {
  return languages.map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);
const es = lang === 'es';

const filters = [
  { id: 'all',      label: es ? 'Todos' : 'All',           n: projects.length },
  { id: 'featured', label: es ? 'Destacados' : 'Featured', n: projects.filter(p => p.featured).length },
  { id: 'work',     label: es ? 'Trabajo' : 'Work',        n: projects.filter(p => p.cat === 'work').length },
  { id: 'product',  label: es ? 'Producto' : 'Product',    n: projects.filter(p => p.cat === 'product').length },
];
---

<Layout title={t.nav.projects} description={t.meta.projects} lang={lang}>
  <Scene lang={lang} variant="band" title={es ? ['Proyectos'] : ['Projects']} seed={21} />

  <section class="band band--cream list">
    <div class="wrap">
      <div class="head">
        <p class="lede">
          {es
            ? 'Software que llegó a producción y se quedó. Productos propios y trabajo interno: todos tienen al menos un usuario que no soy yo.'
            : "Software that made it to production and stuck around. Own products and internal work: all of them have at least one user who isn't me."}
        </p>
        <a href={GITHUB} target="_blank" rel="noopener" class="pill pill--ghost">
          <Icon name="github" size={18} /> GitHub
        </a>
      </div>

      <div class="filters" role="group" aria-label={es ? 'Filtrar proyectos' : 'Filter projects'}>
        {filters.map((f, i) => (
          <button type="button" class="filter" data-filter={f.id} aria-pressed={i === 0 ? 'true' : 'false'}>
            {f.label} <span class="n">{f.n}</span>
          </button>
        ))}
      </div>

      <ProjectRows lang={lang} items={projects} />
      <p class="status" role="status" aria-live="polite"></p>
    </div>
  </section>
</Layout>

<style>
  .list { padding: clamp(56px, 7vw, 96px) 0 clamp(110px, 13vw, 180px); }
  .head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
    margin-bottom: 40px;
  }
  .head .lede { margin: 0; max-width: 44ch; color: var(--ink-soft); }

  .filters { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 28px; }
  .filter {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 18px;
    border-radius: 999px;
    border: 1.5px solid var(--night);
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-weight: 600;
    font-size: 0.95rem;
    cursor: pointer;
    transition: background-color 200ms ease, color 200ms ease, transform 160ms var(--ease-out);
  }
  .filter:active { transform: scale(0.97); }
  .filter[aria-pressed='true'] { background: var(--night); color: var(--cream); }
  .n { font-variant-numeric: tabular-nums; opacity: 0.7; font-weight: 500; }
  @media (hover: hover) and (pointer: fine) {
    .filter[aria-pressed='false']:hover { background: var(--rule); }
  }
  .status { min-height: 1px; margin: 16px 0 0; color: var(--ink-soft); }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const rows = document.querySelectorAll<HTMLElement>('.rows > li');
  const status = document.querySelector<HTMLElement>('.status');
  const lang = document.documentElement.lang;

  buttons.forEach(btn => btn.addEventListener('click', () => {
    const f = btn.dataset.filter;
    buttons.forEach(b => b.setAttribute('aria-pressed', String(b === btn)));
    let shown = 0;
    rows.forEach(row => {
      const match = f === 'all' || (f === 'featured' ? row.dataset.featured === 'true' : row.dataset.cat === f);
      row.hidden = !match;
      if (match) shown++;
    });
    if (status) {
      status.textContent = lang === 'es'
        ? `${shown} ${shown === 1 ? 'proyecto' : 'proyectos'}`
        : `${shown} ${shown === 1 ? 'project' : 'projects'}`;
    }
  }));
</script>
