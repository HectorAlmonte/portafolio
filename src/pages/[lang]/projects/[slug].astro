---
import Layout from '../../../layouts/Layout.astro';
import Scene from '../../../components/Scene.astro';
import Ridge from '../../../components/Ridge.astro';
import Icon from '../../../components/Icon.astro';
import { languages, type Lang } from '../../../i18n/translations';
import { projects } from '../../../data/projects';
import { Image } from 'astro:assets';
import { getShots } from '../../../lib/shots';

export function getStaticPaths() {
  return languages.flatMap(lang =>
    projects.map((p, i) => ({
      params: { lang, slug: p.slug },
      props: { project: p, index: i },
    }))
  );
}

const { lang } = Astro.params as { lang: Lang };
const { project, index } = Astro.props;
const es = lang === 'es';

const prev = projects[index - 1] ?? null;
const next = projects[index + 1] ?? null;

// break long slugs on the hyphen so the title fits the scene
const titleLines = project.title.length > 12 ? project.title.split(/(?<=-)/) : [project.title];

// the first desktop screenshot replaces the text preview; the rest form the gallery
const shots = getShots(project.slug);
const cover = shots.find(s => !s.mobile);
const gallery = shots.filter(s => s !== cover);
const alt = (label: string) => `${project.title}: ${label}`;
---

<Layout title={project.title} description={project.tagline[lang]} lang={lang}>
  <Scene lang={lang} variant="band" title={titleLines} seed={31 + index}>
    <div class="band-foot on-dark">
      <span class="meta">{project.year}</span>
      <span class="meta">{project.kind[lang]}</span>
      <span class="meta status">{project.status[lang]}</span>
    </div>
  </Scene>

  <section class="band band--cream body">
    <div class="wrap">
      <a href={`/${lang}/projects`} class="back link"><Icon name="back" size={16} /> {es ? 'Todos los proyectos' : 'All projects'}</a>

      <p class="lede tagline">{project.tagline[lang]}</p>

      <div class="cols">
        <div>
          <h2 class="sub">{es ? 'El problema' : 'The problem'}</h2>
          <p>{project.problem[lang]}</p>
        </div>
        <div>
          <h2 class="sub">{es ? 'La solución' : 'The solution'}</h2>
          <p>{project.solution[lang]}</p>
        </div>
      </div>

      <div class="links">
        <a href={project.github} target="_blank" rel="noopener" class="pill pill--dark">
          <Icon name="github" size={18} /> GitHub
        </a>
        {project.demo && (
          <a href={project.demo} target="_blank" rel="noopener" class="pill pill--ghost">
            Demo <Icon name="diag" size={16} />
          </a>
        )}
      </div>
    </div>
  </section>

  <Ridge fill="var(--sand)" shape="hills" seed={41 + index} />
  <section class="band band--sand results">
    <div class="wrap results-grid">
      <div>
        <h2 class="h2">{es ? 'Impacto' : 'Impact'}</h2>
        <ul class="impact">
          {project.impact[lang].map((item, i) => (
            <li data-reveal style={`--i:${i}`}>{item}</li>
          ))}
        </ul>
      </div>

      {cover ? (
        <figure class="screen">
          <div class="screen-bar" aria-hidden="true"><span></span><span></span><span></span></div>
          <Image src={cover.src} alt={alt(cover.label)} widths={[640, 960, 1400]} sizes="(max-width: 860px) 100vw, 640px" class="shot" />
        </figure>
      ) : (
        <figure class="screen">
          <div class="screen-bar" aria-hidden="true"><span></span><span></span><span></span></div>
          <pre class="mono" aria-label={es ? 'Vista previa en texto' : 'Text preview'}>{project.mockup.join('\n')}</pre>
        </figure>
      )}
    </div>
  </section>

  {gallery.length > 0 && (
    <section class="band band--sand gallery" aria-label={es ? 'Capturas' : 'Screenshots'}>
      <div class="wrap shots">
        {gallery.map(shot => (
          <figure class:list={['screen', { phone: shot.mobile }]} data-reveal>
            {!shot.mobile && <div class="screen-bar" aria-hidden="true"><span></span><span></span><span></span></div>}
            <Image src={shot.src} alt={alt(shot.label)} widths={shot.mobile ? [320, 640] : [640, 960, 1400]} sizes={shot.mobile ? '320px' : '(max-width: 860px) 100vw, 600px'} class="shot" />
            <figcaption>{shot.label}</figcaption>
          </figure>
        ))}
      </div>
    </section>
  )}

  <section class="band band--sand stack">
    <div class="wrap">
      <h2 class="h2">Stack</h2>
      <dl class="notes">
        {project.stackNotes.map(n => (
          <div>
            <dt>{n.tech}</dt>
            <dd>{n.reason[lang]}</dd>
          </div>
        ))}
      </dl>
      <ul class="chips">{project.stack.map(s => <li class="chip">{s}</li>)}</ul>

      <nav class="pager" aria-label={es ? 'Otros proyectos' : 'Other projects'}>
        {prev ? (
          <a href={`/${lang}/projects/${prev.slug}`} class="pager-link">
            <span class="meta"><Icon name="back" size={14} /> {es ? 'Anterior' : 'Previous'}</span>
            <span class="pager-title">{prev.title}</span>
          </a>
        ) : <span />}
        {next && (
          <a href={`/${lang}/projects/${next.slug}`} class="pager-link right">
            <span class="meta">{es ? 'Siguiente' : 'Next'} <Icon name="arrow" size={14} /></span>
            <span class="pager-title">{next.title}</span>
          </a>
        )}
      </nav>
    </div>
  </section>
</Layout>

<style>
  .band-foot {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    padding: 0 clamp(16px, 3vw, 40px) clamp(18px, 3vw, 32px);
    color: var(--ink-on-dark-soft);
  }
  .band-foot .status { color: var(--sun); }

  .body { padding: clamp(40px, 5vw, 64px) 0 clamp(96px, 12vw, 160px); }
  .back { display: inline-flex; align-items: center; gap: 6px; font-weight: 600; }
  .tagline { max-width: 30ch; margin: 32px 0 clamp(40px, 5vw, 72px); font-size: clamp(1.4rem, 2.6vw, 2rem); line-height: 1.25; }
  .cols { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 5vw, 72px); }
  .cols p { margin: 0; color: var(--ink-soft); max-width: 56ch; }
  .sub {
    margin: 0 0 12px;
    padding-top: 16px;
    border-top: 2px solid var(--night);
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: 1.3rem;
  }
  .links { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 40px; }

  .results { padding: clamp(48px, 6vw, 80px) 0 32px; }
  .results-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: clamp(40px, 6vw, 88px); align-items: start; }
  .impact { list-style: none; margin: 28px 0 0; padding: 0; }
  .impact li {
    padding: 18px 0;
    border-top: 1.5px solid var(--night);
    font-size: 1.1rem;
    font-weight: 500;
    text-wrap: pretty;
  }

  .screen {
    margin: 0;
    border-radius: 20px;
    background: var(--night);
    color: var(--ink-on-dark-soft);
    overflow: hidden;
    box-shadow: 0 24px 48px -16px rgba(44, 15, 30, 0.45);
  }
  .screen-bar { display: flex; gap: 6px; padding: 14px 18px; border-bottom: 1px solid var(--rule-on-dark); }
  .screen-bar span { width: 9px; height: 9px; border-radius: 50%; background: var(--rule-on-dark); }
  .screen pre {
    margin: 0;
    padding: 22px 24px 26px;
    font-size: 0.82rem;
    line-height: 1.55;
    overflow-x: auto;
  }

  .shot { display: block; width: 100%; height: auto; }
  .gallery { padding: 32px 0 0; }
  .shots {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: clamp(20px, 3vw, 36px);
    align-items: start;
  }
  .shots figcaption {
    padding: 10px 18px 14px;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--ink-on-dark-soft);
    text-transform: capitalize;
  }
  .screen.phone {
    justify-self: center;
    width: min(100%, 300px);
    padding: 10px;
    border-radius: 36px;
  }
  .screen.phone .shot { border-radius: 26px; }

  .stack { padding: clamp(56px, 7vw, 96px) 0 clamp(110px, 13vw, 180px); }
  .notes { margin: 28px 0 24px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 56px; }
  .notes div { padding: 18px 0; border-top: 1.5px solid var(--night); }
  .notes dt { font-weight: 700; }
  .notes dd { margin: 4px 0 0; color: var(--ink-soft); }
  .chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .chips .chip { border-color: rgba(44, 15, 30, 0.3); }

  .pager {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    margin-top: clamp(64px, 8vw, 104px);
  }
  .pager-link { display: flex; flex-direction: column; gap: 6px; text-decoration: none; }
  .pager-link.right { text-align: right; align-items: flex-end; }
  .pager-link .meta { display: inline-flex; align-items: center; gap: 6px; color: var(--ink-soft); }
  .pager-title {
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    font-size: clamp(1.3rem, 2.6vw, 2rem);
    line-height: 1;
    transition: transform 300ms var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .pager-link:hover .pager-title { transform: translateX(-6px); }
    .pager-link.right:hover .pager-title { transform: translateX(6px); }
  }

  @media (max-width: 860px) {
    .cols, .results-grid, .notes { grid-template-columns: 1fr; }
  }
</style>
