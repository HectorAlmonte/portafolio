---
import Layout from '../../layouts/Layout.astro';
import Scene from '../../components/Scene.astro';
import Icon from '../../components/Icon.astro';
import { languages, type Lang } from '../../i18n/translations';
import { useTranslations, cvPath, EMAIL, GITHUB, LINKEDIN } from '../../i18n/utils';

export function getStaticPaths() {
  return languages.map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);
const es = lang === 'es';

const topics = es
  ? [
      { id: 'fulltime', label: 'Full-time remoto' },
      { id: 'contract', label: 'Freelance / contrato' },
      { id: 'tech',     label: 'Consulta técnica' },
      { id: 'hi',       label: 'Solo decir hola' },
    ]
  : [
      { id: 'fulltime', label: 'Full-time remote' },
      { id: 'contract', label: 'Freelance / contract' },
      { id: 'tech',     label: 'Technical question' },
      { id: 'hi',       label: 'Just saying hi' },
    ];

const channels = [
  { k: 'LinkedIn', v: '/in/hector-almonte', href: LINKEDIN, icon: 'linkedin' as const },
  { k: 'GitHub',   v: 'HectorAlmonte',      href: GITHUB,   icon: 'github' as const },
];
---

<Layout title={t.nav.contact} description={t.meta.contact} lang={lang} footerCta={false}>
  <Scene lang={lang} variant="band" title={es ? ['Contacto'] : ['Contact']} seed={51} />

  <section class="band band--cream contact">
    <div class="wrap grid">
      <div class="form-col">
        <p class="lede intro">
          {es
            ? 'Cuéntame qué estás construyendo. Los detalles concretos ayudan: equipo, stack y el problema real.'
            : "Tell me what you're building. Concrete details help: team, stack and the real problem."}
        </p>

        <div id="form-success" class="success" hidden tabindex="-1">
          <span class="success-mark"><Icon name="check" size={28} /></span>
          <h2 class="h2">{es ? 'Mensaje enviado' : 'Message sent'}</h2>
          <p>{es ? 'Gracias. Te respondo en menos de 24 horas al email que dejaste.' : "Thanks. I'll reply within 24 hours to the email you left."}</p>
          <a href={cvPath(lang)} download class="pill pill--dark"><Icon name="download" size={18} /> {t.common.cv}</a>
        </div>

        <form id="contact-form" data-lang={lang} novalidate>
          <div class="field">
            <label for="name">{es ? 'Nombre' : 'Name'}</label>
            <input id="name" name="name" type="text" autocomplete="name" required placeholder={es ? 'Tu nombre' : 'Your name'} />
          </div>
          <div class="two">
            <div class="field">
              <label for="email">Email</label>
              <input id="email" name="email" type="email" autocomplete="email" required placeholder={es ? 'tu@empresa.com' : 'you@company.com'} />
            </div>
            <div class="field">
              <label for="company">{es ? 'Empresa' : 'Company'} <span class="opt">{es ? '(opcional)' : '(optional)'}</span></label>
              <input id="company" name="company" type="text" autocomplete="organization" placeholder={es ? 'Dónde trabajas' : 'Where you work'} />
            </div>
          </div>
          <fieldset class="field">
            <legend>{es ? 'Motivo' : 'Topic'}</legend>
            <div class="topics">
              {topics.map((tp, i) => (
                <label class="topic">
                  <input type="radio" name="topic" value={tp.id} checked={i === 0} />
                  <span>{tp.label}</span>
                </label>
              ))}
            </div>
          </fieldset>
          <div class="field">
            <label for="message">{es ? 'Mensaje' : 'Message'}</label>
            <textarea id="message" name="message" rows="6" required placeholder={es ? 'Cuéntame del rol, el equipo, el problema…' : 'Tell me about the role, the team, the problem…'}></textarea>
          </div>

          <p id="form-error" class="error" role="alert" hidden>
            {es ? 'No se pudo enviar. Revisa tu conexión e inténtalo de nuevo, o escríbeme directamente a ' : "It didn't send. Check your connection and try again, or write to me directly at "}
            <a href={`mailto:${EMAIL}`} class="link">{EMAIL}</a>.
          </p>
          <p id="form-invalid" class="error" role="alert" hidden>
            {es ? 'Completa tu nombre, un email válido y el mensaje.' : 'Fill in your name, a valid email and the message.'}
          </p>

          <button id="submit-btn" type="submit" class="pill pill--dark send">
            <span class="label">{es ? 'Enviar mensaje' : 'Send message'}</span>
            <Icon name="arrow" size={18} />
          </button>
        </form>
      </div>

      <aside class="side">
        <div class="block">
          <h2 class="sub">{es ? 'Directo' : 'Direct'}</h2>
          <button id="copy-email-btn" type="button" class="email" data-copied={es ? 'Copiado' : 'Copied'}>
            <span class="email-addr">{EMAIL}</span>
            <span class="email-act"><Icon name="copy" size={16} /> <span class="email-label">{es ? 'Copiar' : 'Copy'}</span></span>
          </button>
          <ul class="channels">
            {channels.map(ch => (
              <li>
                <a href={ch.href} target="_blank" rel="noopener">
                  <Icon name={ch.icon} size={20} />
                  <span><strong>{ch.k}</strong> <span class="muted">{ch.v}</span></span>
                  <Icon name="diag" size={16} />
                </a>
              </li>
            ))}
          </ul>
        </div>
        <div class="block">
          <h2 class="sub">{es ? 'Disponibilidad' : 'Availability'}</h2>
          <p>{es ? 'Abierto a roles full stack remotos y a proyectos de sistemas a medida. Respondo en menos de 24 horas.' : 'Open to remote full stack roles and custom systems projects. I reply within 24 hours.'}</p>
          <p class="muted"><Icon name="pin" size={16} /> {es ? 'Ilo, Perú · GMT−5' : 'Ilo, Peru · GMT−5'}</p>
        </div>
      </aside>
    </div>
  </section>
</Layout>

<style>
  .contact { padding: clamp(56px, 7vw, 96px) 0 clamp(110px, 13vw, 180px); }
  .grid { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(260px, 1fr); gap: clamp(40px, 7vw, 112px); align-items: start; }
  .intro { margin: 0 0 40px; color: var(--ink-soft); }

  form { display: flex; flex-direction: column; gap: 28px; }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  .field { display: flex; flex-direction: column; gap: 8px; border: 0; margin: 0; padding: 0; min-width: 0; }
  label, legend { font-weight: 700; font-size: 0.9rem; padding: 0; }
  .opt { font-weight: 500; color: var(--ink-soft); }
  input[type='text'], input[type='email'], textarea {
    width: 100%;
    padding: 14px 16px;
    border-radius: 14px;
    border: 1.5px solid rgba(44, 15, 30, 0.28);
    background: #fff7ec;
    color: var(--ink);
    font: inherit;
    caret-color: var(--accent);
    transition: border-color 200ms ease, box-shadow 200ms ease;
  }
  textarea { resize: vertical; min-height: 160px; }
  input::placeholder, textarea::placeholder { color: #9a6b70; }
  input:focus, textarea:focus { outline: none; border-color: var(--night); box-shadow: 0 0 0 4px rgba(196, 84, 74, 0.22); }
  input[aria-invalid='true'], textarea[aria-invalid='true'] { border-color: var(--forest-2); }

  .topics { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 4px; }
  .topic { position: relative; cursor: pointer; }
  .topic input { position: absolute; opacity: 0; pointer-events: none; }
  .topic span {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 18px;
    border-radius: 999px;
    border: 1.5px solid var(--night);
    font-weight: 600;
    font-size: 0.95rem;
    transition: background-color 200ms ease, color 200ms ease, transform 160ms var(--ease-out);
  }
  .topic:active span { transform: scale(0.97); }
  .topic input:checked + span { background: var(--night); color: var(--cream); }
  .topic input:focus-visible + span { outline: 2px solid var(--night); outline-offset: 3px; }

  .error {
    margin: 0;
    padding: 14px 16px;
    border-radius: 14px;
    background: rgba(156, 59, 61, 0.12);
    color: var(--forest-3);
    font-weight: 500;
  }
  .send { align-self: flex-start; }
  .send[aria-busy='true'] { opacity: 0.7; pointer-events: none; }
  .send .label { transition: filter 200ms ease, opacity 200ms ease; }
  .send[aria-busy='true'] .label { filter: blur(1px); }

  .success {
    padding: 8px 0 24px;
    transition: opacity 400ms var(--ease-out), transform 400ms var(--ease-out);
    @starting-style { opacity: 0; transform: translateY(8px); }
  }
  .success:focus { outline: none; }
  .success-mark {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--night);
    color: var(--sun);
    margin-bottom: 20px;
  }
  .success p { color: var(--ink-soft); margin: 16px 0 24px; max-width: 46ch; }

  .side { display: flex; flex-direction: column; gap: 40px; }
  .sub {
    margin: 0 0 14px;
    padding-top: 16px;
    border-top: 2px solid var(--night);
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: 1.3rem;
  }
  .block p { margin: 0 0 10px; }
  .muted { color: var(--ink-soft); display: inline-flex; align-items: center; gap: 6px; }

  .email {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 16px;
    border-radius: 14px;
    border: 1.5px solid var(--night);
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    text-align: left;
    transition: background-color 200ms ease, transform 160ms var(--ease-out);
  }
  .email:active { transform: scale(0.98); }
  .email-addr { overflow-wrap: anywhere; }
  .email-act { display: inline-flex; align-items: center; gap: 6px; font-size: 0.88rem; color: var(--ink-soft); flex: none; }
  @media (hover: hover) and (pointer: fine) {
    .email:hover { background: var(--rule); }
    .channels a:hover strong { text-decoration: underline; }
  }
  .channels { list-style: none; margin: 8px 0 0; padding: 0; }
  .channels a {
    display: grid;
    grid-template-columns: 20px 1fr 16px;
    align-items: center;
    gap: 12px;
    padding: 14px 4px;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
  }

  @media (max-width: 860px) {
    .grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .two { grid-template-columns: 1fr; }
  }
</style>

<script>
  const W3F_KEY = 'f25bf8bb-9d38-42e6-a877-50dc6865043d';
  const EMAIL = 'hectoralmoten@gmail.com';

  const form    = document.getElementById('contact-form') as HTMLFormElement;
  const btn     = document.getElementById('submit-btn') as HTMLButtonElement;
  const success = document.getElementById('form-success') as HTMLElement;
  const failed  = document.getElementById('form-error') as HTMLElement;
  const invalid = document.getElementById('form-invalid') as HTMLElement;
  const copyBtn = document.getElementById('copy-email-btn') as HTMLButtonElement;
  const lang    = form.dataset.lang ?? 'es';

  copyBtn?.addEventListener('click', async () => {
    const label = copyBtn.querySelector('.email-label')!;
    const original = label.textContent;
    try {
      await navigator.clipboard.writeText(EMAIL);
      label.textContent = copyBtn.dataset.copied ?? '';
    } catch {
      window.location.href = `mailto:${EMAIL}`;
      return;
    }
    setTimeout(() => { label.textContent = original; }, 1800);
  });

  form.addEventListener('submit', async e => {
    e.preventDefault();
    failed.hidden = true;

    const required = ['name', 'email', 'message'].map(id => form.elements.namedItem(id) as HTMLInputElement);
    let ok = true;
    required.forEach(el => {
      const valid = el.checkValidity() && el.value.trim() !== '';
      el.setAttribute('aria-invalid', String(!valid));
      if (!valid && ok) { el.focus(); ok = false; }
    });
    invalid.hidden = ok;
    if (!ok) return;

    btn.setAttribute('aria-busy', 'true');
    const label = btn.querySelector('.label')!;
    const original = label.textContent;
    label.textContent = lang === 'es' ? 'Enviando…' : 'Sending…';

    try {
      const data = new FormData(form);
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({
          access_key: W3F_KEY,
          name:    data.get('name'),
          email:   data.get('email'),
          company: data.get('company') || '—',
          topic:   data.get('topic'),
          message: data.get('message'),
          subject: `[Portfolio] ${data.get('topic')} — ${data.get('name')}`,
        }),
      });
      const result = await res.json();
      if (!result.success) throw new Error(result.message ?? 'Unknown error');
      form.hidden = true;
      success.hidden = false;
      success.focus();
    } catch (err) {
      console.error('[contact] Web3Forms error:', err);
      failed.hidden = false;
      btn.removeAttribute('aria-busy');
      label.textContent = original;
    }
  });

  form.querySelectorAll('input, textarea').forEach(el =>
    el.addEventListener('input', () => el.removeAttribute('aria-invalid'))
  );
</script>
