---
import Layout from '../../layouts/Layout.astro';
import Scene from '../../components/Scene.astro';
import Ridge from '../../components/Ridge.astro';
import Icon from '../../components/Icon.astro';
import ProjectRows from '../../components/ProjectRows.astro';
import { languages, type Lang } from '../../i18n/translations';
import { useTranslations, cvPath, EMAIL, GITHUB, LINKEDIN } from '../../i18n/utils';
import { projects } from '../../data/projects';
import Timeline from '../../components/Timeline.astro';

export function getStaticPaths() {
  return languages.map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);
const es = lang === 'es';

const title = ['Full-stack', 'developer'];

const strengths = es
  ? [
      { h: 'Industrial y en producción', p: 'Materiales peligrosos, flotas agrícolas y seguridad industrial. Sistemas que se usan todos los días en Global Plus y Agrosoft.' },
      { h: 'De la idea a producción', p: 'Diseño, frontend, backend, base de datos y despliegue. Llevo un sistema completo de punta a punta.' },
      { h: 'Pensado para el terreno', p: 'PWAs que funcionan sin señal, OCR con la cámara, GPS en tiempo real. Software que aguanta la presión del campo.' },
      { h: 'Supervisión y criterio', p: 'Superviso sistemas y operaciones. Hablo con quien usa el software y decido con el negocio, no solo con el código.' },
    ]
  : [
      { h: 'Industrial, in production', p: 'Hazardous materials, agricultural fleets and industrial safety. Systems people use every day at Global Plus and Agrosoft.' },
      { h: 'From idea to production', p: 'Design, front end, back end, database and deployment. I carry a whole system end to end.' },
      { h: 'Built for the field', p: 'PWAs that work with no signal, OCR from the camera, real-time GPS. Software that holds up under field pressure.' },
      { h: 'Supervision and judgment', p: 'I supervise systems and operations. I talk to the people who use the software and decide with the business, not just the code.' },
    ];

const stack = ['TypeScript', 'React', 'Next.js', 'Node.js', '.NET C#', 'PostgreSQL', 'SQL Server', 'Docker'];

const featuredOrder = ['gre-materiales', 'industrial-safety', 'agrosoft-fleet', 'rindex'];
const featured = featuredOrder.map(slug => projects.find(p => p.slug === slug)!);
---

<Layout title="Hector Almonte" description={t.meta.defaultDesc} lang={lang}>
  <Scene lang={lang} title={title}>
    <div class="hero-foot on-dark">
      <div class="intro">
        <p class="who">
          <strong>Hector Almonte</strong>
          <span class="where"><Icon name="pin" size={16} /> {t.common.location}</span>
        </p>
        <p class="tag">
          {es
            ? 'Construyo sistemas industriales que funcionan en terreno, de la idea a producción.'
            : 'I build industrial systems that work in the field, from idea to production.'}
        </p>
        <div class="actions">
          <a href={`/${lang}/projects`} class="pill pill--light">
            {es ? 'Ver proyectos' : 'See projects'} <Icon name="arrow" size={18} />
          </a>
          <a href={cvPath(lang)} download class="pill pill--ghost">
            <Icon name="download" size={18} /> {t.common.cv}
          </a>
        </div>
      </div>
      <nav class="social" aria-label="Social">
        <a href={GITHUB} target="_blank" rel="noopener">github</a>
        <a href={LINKEDIN} target="_blank" rel="noopener">linkedin</a>
        <a href={`mailto:${EMAIL}`}>email</a>
      </nav>
    </div>
  </Scene>

  <!-- What sets the work apart -->
  <section class="band band--cream why">
    <div class="wrap why-grid">
      <div class="why-head">
        <h2 class="h2">{es ? 'Software para el mundo real' : 'Software for the real world'}</h2>
        <p class="lede">
          {es
            ? 'Desde 2021 construyo sistemas que usan personas en almacenes, haciendas y planta. Hoy superviso sistemas y operaciones en Global Plus, en Ilo.'
            : 'Since 2021 I have built systems used by people in warehouses, farms and plants. Today I supervise systems and operations at Global Plus, in Ilo.'}
        </p>
        <ul class="stack" aria-label="Stack">
          {stack.map(s => <li class="chip">{s}</li>)}
        </ul>
      </div>
      <ul class="strengths">
        {strengths.map((s, i) => (
          <li data-reveal style={`--i:${i}`}>
            <h3>{s.h}</h3>
            <p>{s.p}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Projects -->
  <Ridge fill="var(--sand)" shape="hills" seed={5} />
  <section class="band band--sand work">
    <div class="wrap">
      <div class="section-head">
        <h2 class="h2">{es ? 'Proyectos' : 'Projects'}</h2>
        <a href={`/${lang}/projects`} class="pill pill--dark">
          {es ? 'Ver todos' : 'See all'} <Icon name="arrow" size={18} />
        </a>
      </div>
      <ProjectRows lang={lang} items={featured} />
    </div>
  </section>

  <!-- Timeline -->
  <Ridge fill="var(--rust)" shape="peaks" />
  <section class="band band--rust on-dark path">
    <div class="wrap">
      <div class="section-head">
        <h2 class="h2">{es ? 'Trayectoria' : 'Experience'}</h2>
        <a href={`/${lang}/about`} class="pill pill--light">
          {es ? 'Más sobre mí' : 'More about me'} <Icon name="arrow" size={18} />
        </a>
      </div>
      <Timeline lang={lang} />
    </div>
  </section>
</Layout>

<style>
  /* ── hero foot, inside the scene ── */
  .hero-foot {
    margin-top: auto;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    padding: 0 clamp(16px, 3vw, 40px) clamp(18px, 3vw, 36px);
    color: var(--ink-on-dark);
  }
  .intro { max-width: 520px; }
  .who {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 14px;
    margin: 0 0 6px;
    font-size: 1.05rem;
  }
  .who strong { font-weight: 700; }
  .where { display: inline-flex; align-items: center; gap: 4px; color: var(--ink-on-dark-soft); font-weight: 500; }
  .tag { margin: 0 0 20px; font-size: clamp(1rem, 1.5vw, 1.15rem); color: var(--ink-on-dark-soft); text-wrap: pretty; }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; }
  .social { display: flex; gap: 20px; font-weight: 600; font-size: 0.92rem; }
  .social a { text-decoration: none; padding: 8px 0; color: var(--ink-on-dark-soft); transition: color 200ms ease; }
  @media (hover: hover) and (pointer: fine) {
    .social a:hover { color: var(--ink-on-dark); }
  }

  /* ── why ── */
  .why { padding: clamp(72px, 10vw, 140px) 0 clamp(96px, 12vw, 170px); }
  .why-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: clamp(40px, 6vw, 96px);
    align-items: start;
  }
  .why-head .lede { margin: 24px 0 28px; color: var(--ink-soft); }
  .stack { display: flex; flex-wrap: wrap; gap: 8px; list-style: none; padding: 0; margin: 0; }
  .strengths {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px 36px;
  }
  .strengths li { padding-top: 18px; border-top: 2px solid var(--night); }
  .strengths h3 {
    margin: 0 0 10px;
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: 1.3rem;
    line-height: 1.05;
  }
  .strengths p { margin: 0; color: var(--ink-soft); }

  /* ── shared section head ── */
  .section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    margin-bottom: clamp(32px, 4vw, 56px);
  }

  .work { padding: clamp(48px, 6vw, 80px) 0 clamp(110px, 13vw, 180px); }

  /* ── timeline ── */
  .path { padding: clamp(48px, 6vw, 80px) 0 clamp(110px, 13vw, 180px); }

  @media (max-width: 900px) {
    .why-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .hero-foot { flex-direction: column; align-items: flex-start; }
    .social { gap: 18px; }
    .strengths { grid-template-columns: 1fr; gap: 28px; }
  }
</style>
