---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import MobileMenu from '../components/MobileMenu.astro';
import { type Lang } from '../i18n/translations';
import { useTranslations, getLocalizedPath, SITE, GITHUB } from '../i18n/utils';

interface Props {
  title: string;
  description?: string;
  lang: Lang;
  footerCta?: boolean;
}

const { title, description, lang, footerCta = true } = Astro.props;
const t = useTranslations(lang);

const path      = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = new URL(path === `/${lang}` ? `/${lang}/` : path, SITE).href;
const altEs     = new URL(getLocalizedPath(Astro.url.pathname, 'es'), SITE).href;
const altEn     = new URL(getLocalizedPath(Astro.url.pathname, 'en'), SITE).href;
const ogTitle   = title === 'Hector Almonte' ? title : `${title} | Hector Almonte`;
const ogDesc    = description ?? t.meta.defaultDesc;
const ogImage   = `${SITE}/og.png`;

const shortcuts = [
  { key: 'H', label: t.shortcuts.home,     href: `/${lang}/` },
  { key: 'A', label: t.shortcuts.about,    href: `/${lang}/about` },
  { key: 'P', label: t.shortcuts.projects, href: `/${lang}/projects` },
  { key: 'C', label: t.shortcuts.contact,  href: `/${lang}/contact` },
  { key: 'G', label: t.shortcuts.github,   href: GITHUB },
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={ogDesc} />
    <meta name="theme-color" content="#fbe9d2" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{ogTitle}</title>

    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={altEs} />
    <link rel="alternate" hreflang="en" href={altEn} />
    <link rel="alternate" hreflang="x-default" href={altEs} />

    <meta property="og:type"         content="website" />
    <meta property="og:site_name"    content="Hector Almonte" />
    <meta property="og:url"          content={canonical} />
    <meta property="og:title"        content={ogTitle} />
    <meta property="og:description"  content={ogDesc} />
    <meta property="og:image"        content={ogImage} />
    <meta property="og:image:width"  content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale"       content={lang === 'es' ? 'es_PE' : 'en_US'} />
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={ogTitle} />
    <meta name="twitter:description" content={ogDesc} />
    <meta name="twitter:image"       content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Figtree:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Josefin+Sans:wght@600;700&family=JetBrains+Mono:wght@400&display=swap"
    />

    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('js-motion');
      }
    </script>
  </head>
  <body>
    <a href="#main" class="skip">{t.common.skip}</a>
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} cta={footerCta} />
    <MobileMenu lang={lang} />

    <dialog id="kb" class="kb" aria-labelledby="kb-title">
      <h2 id="kb-title">{t.shortcuts.title}</h2>
      <dl>
        {shortcuts.map(s => (
          <div><dt><kbd>{s.key}</kbd></dt><dd>{s.label}</dd></div>
        ))}
        <div><dt><kbd>?</kbd></dt><dd>{t.shortcuts.toggle}</dd></div>
      </dl>
      <form method="dialog"><button class="pill pill--dark">{t.shortcuts.close}</button></form>
    </dialog>

    <style>
      .skip {
        position: fixed;
        top: 12px;
        left: 12px;
        z-index: 200;
        padding: 10px 16px;
        border-radius: 999px;
        background: var(--night);
        color: var(--ink-on-dark);
        font-weight: 600;
        transform: translateY(-160%);
      }
      .skip:focus { transform: none; }

      /* keyboard-opened: no animation, by design */
      .kb {
        width: min(380px, calc(100vw - 32px));
        padding: 28px;
        border: 0;
        border-radius: 24px;
        background: var(--cream);
        color: var(--ink);
        box-shadow: 0 24px 64px rgba(44, 15, 30, 0.35);
      }
      .kb::backdrop { background: rgba(44, 15, 30, 0.55); }
      .kb h2 { margin: 0 0 16px; font-family: var(--font-display); text-transform: uppercase; font-size: 1.4rem; }
      .kb dl { margin: 0 0 20px; }
      .kb dl div { display: flex; align-items: center; gap: 14px; padding: 8px 0; border-top: 1px solid var(--rule); }
      .kb dd { margin: 0; }
      .kb kbd {
        display: inline-grid;
        place-items: center;
        min-width: 30px;
        height: 30px;
        border-radius: 8px;
        background: var(--night);
        color: var(--ink-on-dark);
        font-family: var(--font-body);
        font-weight: 700;
        font-size: 0.85rem;
      }

      @view-transition { navigation: auto; }
      @media (prefers-reduced-motion: reduce) {
        @view-transition { navigation: none; }
      }
    </style>

    <script define:vars={{ shortcuts }}>
      const kb = document.getElementById('kb');
      document.addEventListener('keydown', e => {
        const el = e.target;
        if (el.closest('input, textarea, select, [contenteditable]') || e.metaKey || e.ctrlKey || e.altKey) return;
        if (e.key === '?') {
          e.preventDefault();
          kb.open ? kb.close() : kb.showModal();
          return;
        }
        if (kb.open) return;
        const s = shortcuts.find(x => x.key.toLowerCase() === e.key.toLowerCase());
        if (!s) return;
        if (s.href.startsWith('http')) window.open(s.href, '_blank', 'noopener');
        else window.location.href = s.href;
      });
    </script>

    <script>
      // Lists settle in as they reach the viewport. Content is visible without JS.
      const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if (document.documentElement.classList.contains('js-motion')) {
        const io = new IntersectionObserver(
          entries => entries.forEach(e => {
            if (!e.isIntersecting) return;
            e.target.classList.add('is-in');
            io.unobserve(e.target);
          }),
          { rootMargin: '0px 0px -8% 0px' }
        );
        items.forEach(el => io.observe(el));
      }
    </script>
  </body>
</html>
