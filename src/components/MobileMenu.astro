---
import Icon from './Icon.astro';
import { type Lang } from '../i18n/translations';
import { useTranslations, navLinks, currentSection, cvPath, GITHUB, LINKEDIN } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const here = currentSection(Astro.url.pathname);
---

<div id="menu-sheet" class="sheet on-dark" role="dialog" aria-modal="true" aria-label={t.common.menu} hidden>
  <button class="close" type="button" aria-label={t.common.close} data-menu-close>
    <Icon name="close" size={22} />
  </button>
  <nav>
    {navLinks(lang).map((l, i) => (
      <a href={l.href} class="display" style={`--i:${i}`} aria-current={here === l.id ? 'page' : undefined}>{l.label}</a>
    ))}
  </nav>
  <div class="sheet-foot">
    <a href={cvPath(lang)} download class="pill pill--light">
      <Icon name="download" size={18} /> {t.common.cv}
    </a>
    <div class="social">
      <a href={GITHUB} target="_blank" rel="noopener" aria-label="GitHub"><Icon name="github" size={24} /></a>
      <a href={LINKEDIN} target="_blank" rel="noopener" aria-label="LinkedIn"><Icon name="linkedin" size={24} /></a>
    </div>
  </div>
</div>

<style>
  .sheet {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    flex-direction: column;
    padding: 20px var(--gutter) 28px;
    background: var(--night);
    color: var(--ink-on-dark);
    clip-path: inset(0 0 0 0 round 0);
    transition: clip-path 260ms var(--ease-out), opacity 200ms ease;
  }
  .sheet[hidden] { display: none; }
  .sheet.closed {
    clip-path: inset(0 0 100% 0 round 0 0 40px 40px);
    opacity: 0;
    transition-duration: 180ms;
  }
  .close {
    align-self: flex-end;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: 999px;
    border: 1.5px solid var(--rule-on-dark);
    background: transparent;
    color: inherit;
    cursor: pointer;
  }
  nav {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: auto;
    margin-bottom: auto;
  }
  nav a {
    font-size: clamp(2.6rem, 13vw, 4rem);
    text-decoration: none;
    color: var(--ink-on-dark-soft);
    transition: opacity 360ms var(--ease-out), transform 360ms var(--ease-out);
    transition-delay: calc(60ms + var(--i) * 45ms);
  }
  nav a[aria-current='page'] { color: var(--sun); }
  .sheet.closed nav a { opacity: 0; transform: translateY(12px); transition-delay: 0ms; }
  .sheet-foot { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .social { display: flex; gap: 8px; }
  .social a { display: grid; place-items: center; width: 48px; height: 48px; border-radius: 999px; }

  @media (prefers-reduced-motion: reduce) {
    .sheet, nav a { transition: opacity 150ms ease; }
    .sheet.closed { clip-path: none; }
    .sheet.closed nav a { transform: none; }
  }
</style>

<script>
  const sheet = document.getElementById('menu-sheet');
  const openers = document.querySelectorAll<HTMLButtonElement>('[data-menu-open]');
  const closer = sheet?.querySelector<HTMLButtonElement>('[data-menu-close]');
  let lastFocus: HTMLElement | null = null;

  const open = () => {
    if (!sheet) return;
    lastFocus = document.activeElement as HTMLElement;
    sheet.hidden = false;
    sheet.classList.add('closed');
    requestAnimationFrame(() => requestAnimationFrame(() => sheet.classList.remove('closed')));
    openers.forEach(b => b.setAttribute('aria-expanded', 'true'));
    document.documentElement.style.overflow = 'hidden';
    closer?.focus();
  };
  const close = () => {
    if (!sheet || sheet.hidden) return;
    sheet.classList.add('closed');
    openers.forEach(b => b.setAttribute('aria-expanded', 'false'));
    document.documentElement.style.overflow = '';
    setTimeout(() => { sheet.hidden = true; }, 190);
    lastFocus?.focus();
  };

  openers.forEach(b => b.addEventListener('click', open));
  closer?.addEventListener('click', close);
  document.addEventListener('keydown', e => { if (e.key === 'Escape') close(); });
  sheet?.querySelectorAll('nav a').forEach(a => a.addEventListener('click', close));
</script>
