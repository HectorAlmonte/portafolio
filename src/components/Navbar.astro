---
import Icon from './Icon.astro';
import Mark from './Mark.astro';
import { type Lang } from '../i18n/translations';
import {
  useTranslations, getAlternateLang, getLocalizedPath, navLinks, currentSection, cvPath,
} from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const alt = getAlternateLang(lang);
const altPath = getLocalizedPath(Astro.url.pathname, alt);
const here = currentSection(Astro.url.pathname);
const links = navLinks(lang).filter(l => l.id !== '');
---

<header class="nav">
  <a href={`/${lang}/`} class="brand" aria-label={`Hector Almonte, ${t.nav.home}`}>
    <Mark size={34} />
    <span class="brand-name">Hector Almonte</span>
  </a>

  <nav class="links" aria-label="Principal">
    {links.map(l => (
      <a href={l.href} aria-current={here === l.id ? 'page' : undefined}>{l.label}</a>
    ))}
  </nav>

  <div class="tools">
    <a href={altPath} class="lang" hreflang={alt} lang={alt} aria-label={t.common.langSwitch}>
      <span class:list={{ on: lang === 'es' }}>ES</span>
      <span class:list={{ on: lang === 'en' }}>EN</span>
    </a>
    <a href={cvPath(lang)} download class="pill pill--dark cv">
      <Icon name="download" size={16} />
      {t.common.cvShort}
    </a>
    <button class="menu-btn" type="button" aria-label={t.common.menu} aria-controls="menu-sheet" aria-expanded="false" data-menu-open>
      <Icon name="menu" size={22} />
    </button>
  </div>
</header>

<style>
  .nav {
    display: flex;
    align-items: center;
    gap: 24px;
    padding: clamp(14px, 2.2vw, 28px) clamp(16px, 3vw, 40px);
    color: var(--ink);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    margin-right: auto;
    border-radius: 999px;
  }
  .brand-name {
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    font-size: 1rem;
    letter-spacing: 0.06em;
    padding-top: 0.2em;
  }

  .links { display: flex; gap: 4px; }
  .links a {
    position: relative;
    padding: 10px 14px;
    font-weight: 600;
    font-size: 0.98rem;
    text-decoration: none;
    border-radius: 999px;
    transition: background-color 200ms ease;
  }
  .links a::after {
    content: '';
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: 6px;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 240ms var(--ease-out);
  }
  .links a[aria-current='page']::after { transform: scaleX(1); }
  @media (hover: hover) and (pointer: fine) {
    .links a:hover::after { transform: scaleX(1); }
  }

  .tools { display: flex; align-items: center; gap: 10px; }
  .lang {
    display: inline-flex;
    gap: 2px;
    padding: 4px;
    border-radius: 999px;
    background: rgba(44, 15, 30, 0.08);
    text-decoration: none;
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.04em;
  }
  .lang span {
    display: grid;
    place-items: center;
    min-width: 36px;
    height: 32px;
    border-radius: 999px;
    color: var(--ink-soft);
    transition: background-color 200ms ease, color 200ms ease;
  }
  .lang .on { background: var(--ink-on-dark); color: var(--ink); }
  @media (hover: hover) and (pointer: fine) {
    .lang:hover span:not(.on) { color: var(--ink); }
  }

  .cv { min-height: 42px; padding: 0.6em 1.1em; font-size: 0.92rem; }

  .menu-btn {
    display: none;
    width: 44px;
    height: 44px;
    place-items: center;
    border-radius: 999px;
    background: var(--night);
    color: var(--ink-on-dark);
    border: 0;
    cursor: pointer;
    transition: transform 160ms var(--ease-out);
  }
  .menu-btn:active { transform: scale(0.95); }

  @media (max-width: 860px) {
    .links, .cv { display: none; }
    .menu-btn { display: grid; }
  }
  @media (max-width: 420px) {
    .brand-name { display: none; }
  }
</style>
